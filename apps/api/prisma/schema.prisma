generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "ts"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  HELD
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

model Arena {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  address String
  courts  Court[]
}

model Court {
  id            String         @id @default(uuid()) @db.Uuid
  arenaId       String         @db.Uuid
  name          String
  isActive      Boolean        @default(true)
  arena         Arena          @relation(fields: [arenaId], references: [id])
  scheduleRules ScheduleRule[]
  blocks        Block[]
  reservations  Reservation[]
}

model ScheduleRule {
  id         String @id @default(uuid()) @db.Uuid
  courtId    String @db.Uuid
  weekday    Int
  startHour  Int
  endHour    Int
  priceCents Int
  court      Court  @relation(fields: [courtId], references: [id])
}

model Block {
  id       String   @id @default(uuid()) @db.Uuid
  courtId  String   @db.Uuid
  startsAt DateTime @db.Timestamptz
  reason   String
  court    Court    @relation(fields: [courtId], references: [id])

  @@unique([courtId, startsAt])
}

model Purchase {
  id             String            @id @default(uuid()) @db.Uuid
  customerName   String?
  customerPhone  String?
  status         ReservationStatus
  totalCents     Int
  cancelCodeHash String?
  holdExpiresAt  DateTime          @db.Timestamptz
  createdAt      DateTime          @default(now()) @db.Timestamptz
  reservations   Reservation[]
}

model Reservation {
  id           String            @id @default(uuid()) @db.Uuid
  purchaseId   String            @db.Uuid
  courtId      String            @db.Uuid
  startsAt     DateTime          @db.Timestamptz
  priceCents   Int
  status       ReservationStatus
  cancelReason String?
  cancelledAt  DateTime?         @db.Timestamptz
  purchase     Purchase          @relation(fields: [purchaseId], references: [id])
  court        Court             @relation(fields: [courtId], references: [id])

  @@unique([courtId, startsAt], where: raw("status IN ('HELD', 'PENDING', 'CONFIRMED')"))
}
