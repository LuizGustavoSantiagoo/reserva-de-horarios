# Copie para apps/api/.env e ajuste. Valores fictícios — o .env nunca vai para o Git.
# Os dados de acesso precisam bater com os do .env da raiz (docker-compose.yml).
DATABASE_URL="postgresql://reserva:troque-esta-senha@localhost:5432/reserva?schema=public"
DATABASE_URL_UNPOOLED="postgresql://reserva:troque-esta-senha@localhost:5432/reserva?schema=public"
# Origem do frontend que o navegador deixa ler as respostas da API (CORS): a do `npm run dev` do apps/web.
CORS_ORIGIN="http://localhost:5173"
# Segredo que assina o JWT do painel. Sem ele a API não sobe. Gere um valor longo e aleatório.
JWT_SECRET="troque-este-segredo"
# Validade do JWT, em segundos (opcional; o padrão é 28800 = 8 horas).
JWT_EXPIRES_IN=28800
# Administrador criado pelo seed (npx prisma db seed). Lidas só pelo seed; senha com 8+ caracteres.
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"
