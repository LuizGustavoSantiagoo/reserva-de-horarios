# Copie para apps/web/.env.development antes de rodar `npm run dev`.
# Não use apps/web/.env: ele também vale no `vite build` e levaria este endereço local para produção.
# No build de produção, VITE_API_URL vem do ambiente da hospedagem (fica no bundle; não é segredo).
VITE_API_URL=http://localhost:3000
